# =============================================================================
# CIVITAS — Configuration du stack Jitsi Meet
#
# Copier en .env, puis générer les mots de passe (ne jamais les committer) :
#   cd jitsi && cp .env.example .env && ./gen-passwords.sh
#
# Référence complète des options : https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker
# =============================================================================

# Répertoire de stockage de la configuration Jitsi générée (hors du repo,
# jamais committé — cf. .gitignore).
CONFIG=/opt/civitas/jitsi/data

# Ports exposés (cf. README.md §5 Topologie réseau & ports — déjà réservés
# dans le firewall par 01_system_base.sh)
HTTP_PORT=80
HTTPS_PORT=443
JVB_PORT=10000

# Fuseau horaire du déploiement
TZ=Africa/Libreville

# URL publique du service web — domaine CIVITAS déjà en place (dnsmasq +
# certificats mkcert générés par 01_system_base.sh).
PUBLIC_URL=https://meet.civitas.local

# Le conteneur "web" ne termine PAS le TLS ici : c'est le conteneur "nginx"
# (AJOUT CIVITAS, cf. docker-compose.yml) qui écoute 80/443, présente le
# certificat civitas.local et reverse-proxy en clair vers web:8000. Sans
# cette variable, "web" redirige lui-même tout son trafic HTTP (8000) vers
# son propre HTTPS interne (8443, certificat auto-signé), ce qui casse la
# chaîne nginx -> web (redirection vers un hôte/port interne injoignable
# par le navigateur). Comportement documenté :
# https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker#disable-https
# ENABLE_HTTP_REDIRECT et ENABLE_LETSENCRYPT restent volontairement à leur
# valeur par défaut (0 / désactivé) : nginx gère déjà les deux.
DISABLE_HTTPS=1

# Health-check REST de Jicofo (http://localhost:8888/about/health) :
# - JICOFO_ENABLE_REST active l'interface REST elle-même (sans elle, aucune
#   route REST n'est exposée du tout — confirmé par la doc officielle
#   docker-jitsi-meet : "Jicofo exposes health and metrics endpoints when
#   REST interface is enabled via JICOFO_ENABLE_REST"). Trouvé manquant
#   lors d'un test réel — l'oubli de cette seule variable suffisait à
#   rendre le endpoint de santé inaccessible malgré JICOFO_ENABLE_HEALTH_CHECKS.
# - JICOFO_ENABLE_HEALTH_CHECKS active le test de santé lui-même (Jicofo
#   tente réellement de rejoindre une conférence pour répondre 200) — sans
#   elle, Jicofo n'expose aucun moyen de prouver qu'il est réellement
#   authentifié et opérationnel auprès de Prosody (un simple port TCP
#   ouvert ne le prouve pas — SASL peut échouer après coup).
# Les deux sont nécessaires ensemble. Utilisées par scripts/jitsi_boot.sh
# pour détecter une authentification XMPP cassée (ex: mots de passe
# désynchronisés après un ./gen-passwords.sh relancé sans repartir d'un
# stockage Prosody propre — cf. scripts/jitsi_reset_prosody.sh) au lieu de
# rapporter un faux succès.
JICOFO_ENABLE_REST=1
JICOFO_ENABLE_HEALTH_CHECKS=1

# Webhook MUC vers event-bridge (jitsi/prosody-plugins-custom/mod_muc_webhook.lua)
# — permet à CIVITAS de savoir quand une room/un participant Jitsi RÉEL
# apparaît ou disparaît (cf. PLAN_SYNCHRONISATION_ROOMS_JITSI.md §1-4/§7.7).
#
# XMPP_MUC_MODULES charge le module dans le composant MUC (pas XMPP_MODULES :
# il hook des événements muc-room-*/muc-occupant-* qui n'existent que là).
# XMPP_MUC_CONFIGURATION injecte ses options dans ce même composant — c'est
# le seul point d'extension officiel pour une option non standard comme
# celle-ci (aucune variable XMPP_* dédiée n'existe côté Jitsi pour ça) :
# https://github.com/jitsi/docker-jitsi-meet/pull/503
#
# muc_webhook_secret DOIT être identique à WEBHOOK_SECRET dans
# event-bridge/.env — sinon event-bridge répond 401 à chaque événement
# (cf. event-bridge/config.py). Générer une vraie valeur :
#   openssl rand -hex 32
XMPP_MUC_MODULES=muc_webhook
XMPP_MUC_CONFIGURATION=muc_webhook_url = "http://civitas-event-bridge:8100/webhook"; muc_webhook_secret = "CHANGE_ME_SAME_AS_EVENT_BRIDGE_WEBHOOK_SECRET"

# IP(s) à annoncer par le JVB pour la négociation ICE — généralement inutile
# sur un serveur LAN simple (cas CIVITAS). À ne renseigner que si les clients
# ne parviennent pas à établir la connexion média (scénario NAT/cloud) :
# reprendre la valeur de CIVITAS_IP (/opt/civitas/config/civitas.env),
# jamais une IP codée en dur ici.
#JVB_ADVERTISE_IPS=<valeur de CIVITAS_IP si nécessaire>

#
# Sécurité — mots de passe XMPP inter-composants
# NE JAMAIS committer de vraies valeurs. Générés par ./gen-passwords.sh
# (openssl rand -hex 16 par mot de passe, remplace ces lignes automatiquement).
#
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

#
# Docker Compose
#
RESTART_POLICY=unless-stopped
# Image stable — l'upstream (docker-compose.yml vendored) défaut sur
# "unstable" (branche de développement/CI du projet Jitsi) : jamais adapté
# à un déploiement de production. Fixé ici plutôt que dans le compose vendored,
# pour minimiser les écarts volontaires dans ce dernier (listés en en-tête
# de jitsi/docker-compose.yml, chacun marqué "AJOUT CIVITAS").
JITSI_IMAGE_VERSION=stable
