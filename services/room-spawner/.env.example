# Copier en .env et renseigner les valeurs réelles.
# ATTENTION : si un .env existe déjà en production, vérifier qu'il ne surcharge
# pas KAFKA_BOOTSTRAP avec l'IP hôte (192.168.1.89:9092) — cela provoque des
# blocages/timeouts de connexion depuis les conteneurs (cf. correctif config.py).

# Listener INTERNAL Docker uniquement — jamais l'IP hôte ici.
KAFKA_BOOTSTRAP=civitas-kafka:9094

PEER_SERVICE_URL=http://civitas-peer:8002
ROOM_CONFIG_URL=http://civitas-room-config:8010
ROOM_CONFIG_TOKEN=civitas-room-config-token
PEER_SERVICE_TOKEN=civitas-peer-token

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8011
AUTO_JOIN=true
AUTO_LEAVE=true
