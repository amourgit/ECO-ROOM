# Copier en .env et renseigner les valeurs réelles.

DATABASE_URL=postgresql://civitas:civitas2024@civitas-postgres:5432/room_config

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8010
API_TOKEN=civitas-room-config-token

# Consumer d'historique de réunion (room.transcriptions -> Postgres).
# Listener INTERNAL Docker uniquement — jamais l'IP hôte.
KAFKA_BOOTSTRAP=civitas-kafka:9094
HISTORY_KAFKA_ENABLED=true
