# Copier en .env et renseigner les valeurs réelles.
#
# ATTENTION — différence fondamentale avec l'ancien services/peer/.env.example :
# ROOM_ID est désormais OBLIGATOIRE et fixe la seule room que CE process peut jamais servir
# (cf. docs/architecture/03-isolation-et-orchestration.md §2). En production, cette variable
# est positionnée dynamiquement par civitas-orchestrator au moment du `docker run` — ce
# .env.example sert uniquement au développement local d'une instance isolée.

ROOM_ID=

GEMINI_API_KEY=

JITSI_HOST=meet.civitas.local
JITSI_CA_CERT=/certs/civitas.local.crt

ROOM_CONFIG_URL=http://civitas-room-config:8010
ROOM_CONFIG_TOKEN=civitas-room-config-token

# Listener INTERNAL Docker uniquement — jamais l'IP hôte ici (cf. avertissement identique
# déjà présent dans tous les .env.example du dépôt).
KAFKA_BOOTSTRAP=civitas-kafka:9094

# Checkpoint LangGraph (docs/architecture/01-architecture-cible-civitas-agent.md §7, niveau 3)
CHECKPOINT_DATABASE_URL=postgresql://civitas:civitas2024@civitas-postgres:5432/room_config

# Mémoire de réunion (identique à l'ancien peer)
HISTORY_REHYDRATE_LIMIT=300
CONTEXT_MAX_ENTRIES=80
ORAL_REQUEST_KEYWORDS=oral,voix,parle,vocal,dis à voix,à voix haute,audio

# API de contrôle locale à CETTE room (jamais publiée sur l'hôte en production — adressée par
# civitas-orchestrator via le DNS interne civitas-net, cf. doc 03 §4.3)
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8300
API_TOKEN=civitas-agent-token
