# Copier en .env et renseigner les valeurs réelles.

KAFKA_BOOTSTRAP=civitas-kafka:9094

ROOM_CONFIG_URL=http://civitas-room-config:8010
ROOM_CONFIG_TOKEN=civitas-room-config-token

# Image et réseau utilisés pour le spawn dynamique (docs/architecture/03-isolation-et-orchestration.md §4.3)
AGENT_IMAGE=civitas-agent-runtime:latest
AGENT_NETWORK=civitas-net
AGENT_INTERNAL_PORT=8300
AGENT_SHM_SIZE=2g
AGENT_MEM_LIMIT=1g
AGENT_API_TOKEN=civitas-agent-token

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8011
MODERATOR_API_TOKEN=civitas-moderator-token
