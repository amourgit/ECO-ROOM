# Commandes — Room Config (:8010)
# ============================================================================

def _room_payload(args) -> dict:
    payload = {}
    if args.agent_name is not None: payload["agent_name"] = args.agent_name
    if args.prompt is not None: payload["system_prompt"] = args.prompt
    if args.behavior_mode is not None: payload["behavior_mode"] = args.behavior_mode
    if args.language is not None: payload["language"] = args.language
    if args.can_speak is not None: payload["can_speak"] = args.can_speak
    if args.can_write_chat is not None: payload["can_write_chat"] = args.can_write_chat
    if args.can_use_tools is not None: payload["can_use_tools"] = args.can_use_tools
    if args.can_use_rag is not None: payload["can_use_rag"] = args.can_use_rag
    if args.can_moderate is not None: payload["can_moderate"] = args.can_moderate
    if args.peer_enabled is not None: payload["peer_enabled"] = args.peer_enabled
    if args.active is not None: payload["is_active"] = args.active
    if args.keywords is not None: payload["invocation_keywords"] = args.keywords.split(",")
    if args.tools is not None: payload["tools_allowed"] = args.tools.split(",")
    if args.extra_config is not None:
        try:
            payload["extra_config"] = json.loads(args.extra_config)
        except json.JSONDecodeError as e:
            die(f"--extra-config doit être un JSON valide : {e}")
    return payload


def cmd_room_reserve(cfg: Config, args):
    payload = {"room_id": args.room_id, **_room_payload(args)}
    return post(f"{cfg.room_config_url}/rooms/reserve", token=cfg.room_config_token, json_body=payload)


def cmd_room_create(cfg: Config, args):
    payload = {"room_id": args.room_id, **_room_payload(args)}
    return post(f"{cfg.room_config_url}/rooms/", token=cfg.room_config_token, json_body=payload)


def cmd_room_get(cfg: Config, args):
    return get(f"{cfg.room_config_url}/rooms/{args.room_id}", token=cfg.room_config_token)


def cmd_room_list(cfg: Config, args):
    return get(f"{cfg.room_config_url}/rooms/", token=cfg.room_config_token,
               params={"skip": args.skip, "limit": args.limit})


def cmd_room_update(cfg: Config, args):
    payload = _room_payload(args)
    if not payload:
        die("Aucun champ à mettre à jour — passer au moins une option (--agent-name, --behavior-mode, --peer-enabled...)")
    return patch(f"{cfg.room_config_url}/rooms/{args.room_id}", token=cfg.room_config_token, json_body=payload)


def cmd_room_delete(cfg: Config, args):
    delete(f"{cfg.room_config_url}/rooms/{args.room_id}", token=cfg.room_config_token)
    return {"status": "deleted", "room_id": args.room_id}


def cmd_room_context(cfg: Config, args):
    return get(f"{cfg.room_config_url}/rooms/{args.room_id}/context", token=cfg.room_config_token)


def cmd_room_history(cfg: Config, args):
    return get(f"{cfg.room_config_url}/rooms/{args.room_id}/history", token=cfg.room_config_token,
               params={"limit": args.limit})


