#!/usr/bin/env python3
"""
civitas — CLI de pilotage de la plateforme CIVITAS (rooms, peers, modération).

Zéro dépendance externe (stdlib uniquement — urllib/json/argparse) : marche
sur n'importe quelle machine avec Python 3.9+, sans rien installer.

Couvre l'intégralité du cycle de vie documenté dans DOCUMENTATION_API.md §0 :
réserver une room, faire rejoindre le peer, l'interroger, le modérer
(kick/mute — vraies API JitsiConference, pas une simulation), l'éjecter.

Configuration (ordre de priorité, du plus fort au plus faible) :
  1. Options en ligne de commande (--room-config-url, --token, etc.)
  2. Variables d'environnement (CIVITAS_ROOM_CONFIG_URL, CIVITAS_HOST, ...)
  3. Fichier de config (~/.civitas.env ou /opt/civitas/cli/.env, format
     KEY=VALUE, une par ligne — cf. `civitas config --show`)
  4. Défauts intégrés (localhost, tokens de DOCUMENTATION_API.md)

Usage rapide :
  civitas health
  civitas room reserve ma-salle --agent-name CIVITAS --prompt "..."
  civitas peer inject ma-salle
  civitas peer status ma-salle
  civitas peer kick ma-salle a1b2c3d4 --reason "hors sujet"
  civitas --help
  civitas room --help
  civitas peer kick --help
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import urlencode

# ============================================================================
# Configuration
# ============================================================================

DEFAULT_CONFIG_PATHS = [
    os.path.expanduser("~/.civitas.env"),
    "/opt/civitas/cli/.env",
]

# Défauts alignés sur jitsi/.env.example, event-bridge/.env.example et
# services/*/.env.example — à écraser via variables d'environnement ou
# fichier de config pour un déploiement réel.
DEFAULTS = {
    "HOST": "localhost",
    "ROOM_CONFIG_PORT": "8010",
    "ROOM_SPAWNER_PORT": "8011",
    "PEER_PORT": "8002",
    "EVENT_BRIDGE_PORT": "8100",
    "ROOM_CONFIG_TOKEN": "civitas-room-config-token",
    "PEER_TOKEN": "civitas-peer-token",
    "WEBHOOK_SECRET": "",
}


def _load_config_file() -> dict:
    """Parseur KEY=VALUE minimal — aucune dépendance à python-dotenv."""
    values = {}
    for path in DEFAULT_CONFIG_PATHS:
        if not os.path.isfile(path):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    key, _, val = line.partition("=")
                    values[key.strip()] = val.strip().strip('"').strip("'")
        except OSError:
            pass
    return values


class Config:
    """Résout host/ports/tokens selon l'ordre de priorité documenté en tête."""

    def __init__(self, args: argparse.Namespace):
        file_cfg = _load_config_file()

        def resolve(key: str, cli_value=None) -> str:
            if cli_value is not None:
                return cli_value
            env_key = f"CIVITAS_{key}"
            if env_key in os.environ:
                return os.environ[env_key]
            if key in file_cfg:
                return file_cfg[key]
            return DEFAULTS[key]

        self.host = resolve("HOST", args.host)
        self.room_config_url = args.room_config_url or f"http://{self.host}:{resolve('ROOM_CONFIG_PORT')}"
        self.room_spawner_url = args.room_spawner_url or f"http://{self.host}:{resolve('ROOM_SPAWNER_PORT')}"
        self.peer_url = args.peer_url or f"http://{self.host}:{resolve('PEER_PORT')}"
        self.event_bridge_url = args.event_bridge_url or f"http://{self.host}:{resolve('EVENT_BRIDGE_PORT')}"
        self.room_config_token = resolve("ROOM_CONFIG_TOKEN", args.token)
        self.peer_token = resolve("PEER_TOKEN", args.token)
        self.webhook_secret = resolve("WEBHOOK_SECRET", args.webhook_secret)

    def show(self):
        print("Configuration résolue :")
        print(f"  ROOM_CONFIG_URL   = {self.room_config_url}")
        print(f"  ROOM_SPAWNER_URL  = {self.room_spawner_url}")
        print(f"  PEER_URL          = {self.peer_url}")
        print(f"  EVENT_BRIDGE_URL  = {self.event_bridge_url}")
        print(f"  ROOM_CONFIG_TOKEN = {self.room_config_token[:4]}{'*' * max(0, len(self.room_config_token) - 4)}")
        print(f"  PEER_TOKEN        = {self.peer_token[:4]}{'*' * max(0, len(self.peer_token) - 4)}")
        secret_display = (self.webhook_secret[:4] + "***") if self.webhook_secret else "(non configuré)"
        print(f"  WEBHOOK_SECRET    = {secret_display}")
        print()
        print("Fichiers de config cherchés (le premier trouvé gagne, KEY=VALUE) :")
        for p in DEFAULT_CONFIG_PATHS:
            print(f"  {p}{'  [trouvé]' if os.path.isfile(p) else ''}")


# ============================================================================
# Client HTTP — stdlib uniquement
# ============================================================================

class ApiError(Exception):
    def __init__(self, status: int, body: str, url: str):
        self.status = status
        self.body = body
        self.url = url
        super().__init__(f"HTTP {status} sur {url} : {body}")


def _request(method: str, url: str, token: str = None, webhook_secret: str = None,
             json_body: dict = None, params: dict = None) -> dict:
    if params:
        url = f"{url}?{urlencode(params)}"

    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if webhook_secret:
        headers["X-Civitas-Webhook-Secret"] = webhook_secret

    data = json.dumps(json_body).encode("utf-8") if json_body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise ApiError(e.code, body, url) from None
    except urllib.error.URLError as e:
        raise ApiError(0, f"Connexion impossible ({e.reason}) — service down ou mauvaise URL ?", url) from None


def get(url, token=None, params=None):
    return _request("GET", url, token=token, params=params)


def post(url, token=None, json_body=None, webhook_secret=None):
    return _request("POST", url, token=token, json_body=json_body or {}, webhook_secret=webhook_secret)


def patch(url, token=None, json_body=None):
    return _request("PATCH", url, token=token, json_body=json_body or {})


def delete(url, token=None):
    return _request("DELETE", url, token=token)


# ============================================================================
# Sortie
# ============================================================================

def _supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def print_json(data, raw: bool = False):
    if raw:
        print(json.dumps(data, ensure_ascii=False))
        return
    text = json.dumps(data, indent=2, ensure_ascii=False, sort_keys=False)
    if _supports_color():
        # Coloration minimale, sans dépendance — clés en cyan, chaînes en vert.
        import re
        text = re.sub(r'"([^"]+)":', r'\033[36m"\1"\033[0m:', text)
        text = re.sub(r': "([^"]*)"', r': \033[32m"\1"\033[0m', text)
    print(text)


def die(message: str, code: int = 1):
    print(f"Erreur : {message}", file=sys.stderr)
    sys.exit(code)


def run_command(fn, cfg, args, raw: bool = False):
    """Exécute une commande, formate proprement toute ApiError."""
    try:
        result = fn(cfg, args)
        if result is not None:
            print_json(result, raw=raw)
    except ApiError as e:
        hint = ""
        if e.status == 401:
            hint = " (token/secret invalide — cf. `civitas config --show`)"
        elif e.status == 404:
            hint = " (room/participant introuvable)"
        elif e.status == 0:
            hint = " (le service est-il démarré ? cf. `civitas health`)"
        die(f"HTTP {e.status}{hint}\n{e.body}")


