# ============================================================================
# Santé de la plateforme
# ============================================================================

def cmd_health(cfg: Config, args):
    services = [
        ("room-config", cfg.room_config_url, cfg.room_config_token),
        ("room-spawner", cfg.room_spawner_url, cfg.peer_token),
        ("peer", cfg.peer_url, cfg.peer_token),
        ("event-bridge", cfg.event_bridge_url, None),
    ]
    results = {}
    all_ok = True
    for name, url, token in services:
        try:
            r = get(f"{url}/health", token=token)
            results[name] = r
        except ApiError as e:
            results[name] = {"status": "unreachable", "error": str(e)}
            all_ok = False
    print_json(results, raw=args.raw)
    if not all_ok:
        sys.exit(1)
    return None  # déjà imprimé


# ============================================================================
# Kafka (wrapping docker exec — nécessite un accès Docker local)
# ============================================================================

KAFKA_CONTAINER = "civitas-kafka"
KAFKA_BOOTSTRAP = "civitas-kafka:9094"


def cmd_kafka_topics(cfg: Config, args):
    _docker_exec(["kafka-topics", "--bootstrap-server", KAFKA_BOOTSTRAP, "--list"])


def cmd_kafka_consume(cfg: Config, args):
    cmd = ["kafka-console-consumer", "--bootstrap-server", KAFKA_BOOTSTRAP, "--topic", args.topic,
           "--max-messages", str(args.max_messages)]
    if args.from_beginning:
        cmd.append("--from-beginning")
    _docker_exec(cmd)


def _docker_exec(kafka_cmd: list):
    full_cmd = ["docker", "exec", KAFKA_CONTAINER] + kafka_cmd
    try:
        subprocess.run(full_cmd, check=True)
    except FileNotFoundError:
        die("`docker` introuvable — cette commande nécessite un accès Docker local au serveur CIVITAS.")
    except subprocess.CalledProcessError as e:
        die(f"docker exec a échoué (code {e.returncode})")


# ============================================================================
# Argparse — arbre de commandes
# ============================================================================

def _make_global_parser() -> argparse.ArgumentParser:
    """
    Parent parser partagé (argparse `parents=`) — attaché au parser racine
    ET à chaque sous-commande feuille, pour que les options globales soient
    reconnues aussi bien avant qu'après la sous-commande :
      civitas --host X room reserve id      (avant)
      civitas room reserve id --host X      (après — sinon rejeté par argparse)
    """
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--host", default=None, help="Hôte des services (défaut : localhost ou CIVITAS_HOST)")
    p.add_argument("--room-config-url", default=None, help="Override complet de l'URL room-config")
    p.add_argument("--room-spawner-url", default=None, help="Override complet de l'URL room-spawner")
    p.add_argument("--peer-url", default=None, help="Override complet de l'URL peer-service")
    p.add_argument("--event-bridge-url", default=None, help="Override complet de l'URL event-bridge")
    p.add_argument("--token", default=None, help="Token Bearer (remplace ROOM_CONFIG_TOKEN et PEER_TOKEN)")
    p.add_argument("--webhook-secret", default=None, help="Secret webhook (X-Civitas-Webhook-Secret)")
    p.add_argument("--raw", action="store_true", help="Sortie JSON brute (une ligne, pour le scripting)")
    return p


def _add_room_config_options(p: argparse.ArgumentParser):
    """Options de configuration partagées entre `room reserve/create/update`."""
    p.add_argument("--agent-name", default=None, help="Nom affiché de l'agent (défaut serveur : CIVITAS)")
    p.add_argument("--prompt", default=None, help="System prompt (généré automatiquement si omis)")
    p.add_argument("--behavior-mode", default=None, choices=["on_call", "proactive", "silent"])
    p.add_argument("--language", default=None, help="Langue de réponse (défaut serveur : fr)")
    p.add_argument("--can-speak", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--can-write-chat", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--can-use-tools", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--can-use-rag", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--can-moderate", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--peer-enabled", action=argparse.BooleanOptionalAction, default=None)
    p.add_argument("--active", action=argparse.BooleanOptionalAction, default=None, help="is_active")
    p.add_argument("--keywords", default=None, help="Mots-clés séparés par des virgules, ex: civitas,budget")
    p.add_argument("--tools", default=None, help="Outils autorisés séparés par des virgules")
    p.add_argument("--extra-config", default=None, help="JSON libre, ex: '{\"foo\": \"bar\"}'")


def build_parser() -> argparse.ArgumentParser:
    gp = _make_global_parser()  # un seul parent, réutilisé partout

    parser = argparse.ArgumentParser(
        prog="civitas",
        description="CLI de pilotage CIVITAS — rooms, peers, modération. Voir DOCUMENTATION_API.md §0 pour le guide complet.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[gp],
    )
    sub = parser.add_subparsers(dest="resource", required=True)

    # --- config ---
    p_config = sub.add_parser("config", help="Afficher la configuration résolue (URLs, tokens masqués)", parents=[gp])
    p_config.add_argument("--show", action="store_true", help="Sans effet — la config s'affiche toujours (option de confort, style kubectl)")
    p_config.set_defaults(handler=None)

    # --- health ---
    p_health = sub.add_parser("health", help="Vérifier l'état de tous les services CIVITAS", parents=[gp])
    p_health.set_defaults(handler=cmd_health)

    # --- room ---
    p_room = sub.add_parser("room", help="Gestion des configurations de room (room-config, :8010)", parents=[gp])
    room_sub = p_room.add_subparsers(dest="action", required=True)

    p = room_sub.add_parser("reserve", parents=[gp], help="[RECOMMANDÉ] Réserver une room (status=pending jusqu'à confirmation Jitsi réelle)")
    p.add_argument("room_id")
    _add_room_config_options(p)
    p.set_defaults(handler=cmd_room_reserve)

    p = room_sub.add_parser("create", parents=[gp], help="[LEGACY] Créer une room directement confirmed — préférer `reserve`")
    p.add_argument("room_id")
    _add_room_config_options(p)
    p.set_defaults(handler=cmd_room_create)

    p = room_sub.add_parser("get", parents=[gp], help="Voir une room")
    p.add_argument("room_id")
    p.set_defaults(handler=cmd_room_get)

    p = room_sub.add_parser("list", parents=[gp], help="Lister les rooms")
    p.add_argument("--skip", type=int, default=0)
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(handler=cmd_room_list)

    p = room_sub.add_parser("update", parents=[gp], help="Mettre à jour une room (PATCH partiel)")
    p.add_argument("room_id")
    _add_room_config_options(p)
    p.set_defaults(handler=cmd_room_update)

    p = room_sub.add_parser("delete", parents=[gp], help="Supprimer une room")
    p.add_argument("room_id")
    p.set_defaults(handler=cmd_room_delete)

    p = room_sub.add_parser("context", parents=[gp], help="Contexte agent (déclenche aussi la confirmation pending->confirmed)")
    p.add_argument("room_id")
    p.set_defaults(handler=cmd_room_context)

    p = room_sub.add_parser("history", parents=[gp], help="Historique complet de la réunion")
    p.add_argument("room_id")
    p.add_argument("--limit", type=int, default=200)
    p.set_defaults(handler=cmd_room_history)

    # --- peer ---
    p_peer = sub.add_parser("peer", help="Pilotage du peer dans les rooms (room-spawner :8011 / peer-service :8002)", parents=[gp])
    peer_sub = p_peer.add_subparsers(dest="action", required=True)

    p = peer_sub.add_parser("inject", parents=[gp], help="Faire rejoindre le peer manuellement")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_peer_inject)

    p = peer_sub.add_parser("eject", parents=[gp], help="Éjecter le peer (désactive aussi peer_enabled)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_peer_eject)

    p = peer_sub.add_parser("standby", parents=[gp], help="Mettre le peer en silence (behavior_mode=silent)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_peer_standby)

    p = peer_sub.add_parser("activate", parents=[gp], help="Réactiver le peer (behavior_mode=on_call)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_peer_activate)

    p = peer_sub.add_parser("active", parents=[gp], help="Lister les rooms où un peer est actif")
    p.set_defaults(handler=cmd_peer_active)

    p = peer_sub.add_parser("instances", parents=[gp], help="Instances peer actives (vue directe peer-service)")
    p.set_defaults(handler=cmd_peer_instances)

    p = peer_sub.add_parser("status", parents=[gp], help="État modérateur réel du peer (can_moderate + is_moderator)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_peer_status)

    p = peer_sub.add_parser("kick", parents=[gp], help="Exclure un participant (vraie room Jitsi — requiert le rôle moderator)")
    p.add_argument("room_id")
    p.add_argument("participant_id")
    p.add_argument("--reason", default=None)
    p.set_defaults(handler=cmd_peer_kick)

    p = peer_sub.add_parser("mute", parents=[gp], help="Couper le micro d'un participant à distance (irréversible à distance)")
    p.add_argument("room_id")
    p.add_argument("participant_id")
    p.set_defaults(handler=cmd_peer_mute)

    p = peer_sub.add_parser("send-text", parents=[gp], help="Injecter un texte dans le pipeline Gemini (l'agent le dira à voix haute)")
    p.add_argument("room_id")
    p.add_argument("text")
    p.set_defaults(handler=cmd_peer_send_text)

    p = peer_sub.add_parser("send-chat", parents=[gp], help="Écrire directement dans le chat Jitsi (sans passer par Gemini)")
    p.add_argument("room_id")
    p.add_argument("text")
    p.set_defaults(handler=cmd_peer_send_chat)

    # --- webhook (simulation, dev/test) ---
    p_wh = sub.add_parser("webhook", help="Simuler des événements Prosody / consulter l'état event-bridge (:8100)", parents=[gp])
    wh_sub = p_wh.add_subparsers(dest="action", required=True)

    p = wh_sub.add_parser("room-created", parents=[gp], help="Simuler muc-room-created (nécessite --webhook-secret)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_webhook_room_created)

    p = wh_sub.add_parser("room-destroyed", parents=[gp], help="Simuler muc-room-destroyed (nécessite --webhook-secret)")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_webhook_room_destroyed)

    p = wh_sub.add_parser("participant-joined", parents=[gp], help="Simuler muc-occupant-joined (nécessite --webhook-secret)")
    p.add_argument("room_id")
    p.add_argument("--jid", required=True, help="JID réel du participant (occupant_jid)")
    p.add_argument("--nick", default="Test")
    p.add_argument("--role", default="participant", choices=["visitor", "participant", "moderator"])
    p.add_argument("--affiliation", default="none", choices=["none", "member", "admin", "owner", "outcast"])
    p.set_defaults(handler=cmd_webhook_participant_joined)

    p = wh_sub.add_parser("participant-left", parents=[gp], help="Simuler muc-occupant-left (nécessite --webhook-secret)")
    p.add_argument("room_id")
    p.add_argument("--jid", required=True)
    p.add_argument("--nick", default="Test")
    p.add_argument("--role", default="participant", choices=["visitor", "participant", "moderator"])
    p.add_argument("--affiliation", default="none", choices=["none", "member", "admin", "owner", "outcast"])
    p.set_defaults(handler=cmd_webhook_participant_left)

    p = wh_sub.add_parser("rooms", parents=[gp], help="État complet des rooms vues par event-bridge")
    p.set_defaults(handler=cmd_webhook_rooms)

    p = wh_sub.add_parser("room", parents=[gp], help="État d'une room vue par event-bridge")
    p.add_argument("room_id"); p.set_defaults(handler=cmd_webhook_room)

    # --- kafka (wrapping docker exec) ---
    p_kafka = sub.add_parser("kafka", help="Raccourcis Kafka (nécessite un accès docker local au serveur)", parents=[gp])
    kafka_sub = p_kafka.add_subparsers(dest="action", required=True)

    p = kafka_sub.add_parser("topics", parents=[gp], help="Lister les topics Kafka")
    p.set_defaults(handler=cmd_kafka_topics)

    p = kafka_sub.add_parser("consume", parents=[gp], help="Consommer un topic (ctrl-C pour arrêter en mode continu)")
    p.add_argument("topic")
    p.add_argument("--from-beginning", action="store_true")
    p.add_argument("--max-messages", type=int, default=10)
    p.set_defaults(handler=cmd_kafka_consume)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.resource == "config":
        Config(args).show()
        return

    cfg = Config(args)
    run_command(args.handler, cfg, args, raw=args.raw)


if __name__ == "__main__":
    main()
