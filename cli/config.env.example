# Copier vers ~/.civitas.env (utilisateur courant) ou /opt/civitas/cli/.env
# (partagé) — jamais committer la copie remplie (contient un secret).
#
# Toutes ces valeurs peuvent aussi être passées en options (--host, ...)
# ou variables d'environnement CIVITAS_* — cf. cli/README.md.

HOST=localhost

# Doit correspondre à API_TOKEN dans services/room-config/.env
ROOM_CONFIG_TOKEN=civitas-room-config-token

# Doit correspondre à PEER_SERVICE_TOKEN/ROOM_CONFIG_TOKEN dans
# services/room-spawner/.env et services/peer/.env
PEER_TOKEN=civitas-peer-token

# Doit correspondre à WEBHOOK_SECRET dans event-bridge/.env (et
# muc_webhook_secret côté jitsi/.env, XMPP_MUC_CONFIGURATION) — nécessaire
# uniquement pour `civitas webhook *` (simulation, dev/test)
WEBHOOK_SECRET=
