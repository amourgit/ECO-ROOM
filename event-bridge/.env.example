# Copier en .env et renseigner les valeurs réelles si besoin de les changer.

# Listener INTERNAL Docker uniquement — jamais l'IP hôte ici.
KAFKA_BOOTSTRAP=civitas-kafka:9094

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8100

# Secret partagé avec Prosody (mod_muc_webhook.lua, option muc_webhook_secret
# injectée via XMPP_MUC_CONFIGURATION dans jitsi/.env — DOIT être la même
# valeur ici et là-bas). Sans ce secret, /webhook accepte n'importe quel
# POST de n'importe qui sur le réseau (le port 8100 est publié sur l'hôte)
# et l'injecte dans tout le pipeline CIVITAS comme si c'était un vrai
# événement Jitsi — cf. PLAN_SYNCHRONISATION_ROOMS_JITSI.md.
#   openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_SAME_AS_PROSODY_MUC_WEBHOOK_SECRET
