# CIVITAS PLATFORM — Variables globales
# Ceci est un TEMPLATE. Le fichier réel (/opt/civitas/config/civitas.env)
# est généré automatiquement par 01_system_base.sh avec les vraies valeurs
# détectées dynamiquement (IP, sous-réseau) — ne jamais committer de vraies
# valeurs d'environnement ni de secrets ici.
CIVITAS_DOMAIN=civitas.local
CIVITAS_IP=<détectée dynamiquement par 01_system_base.sh — ip route get>
CIVITAS_SUBNET=<détecté dynamiquement par 01_system_base.sh>
JITSI_DOMAIN=meet.civitas.local
KAFKA_DOMAIN=kafka.civitas.local
GRAFANA_DOMAIN=grafana.civitas.local
KAFKA_UI_DOMAIN=kafka-ui.civitas.local
TLS_CERT=/opt/civitas/certs/civitas.local.crt
TLS_KEY=/opt/civitas/certs/civitas.local.key
CA_CERT=/opt/civitas/certs/ca/rootCA.pem
DOCKER_NETWORK=civitas-net
# ATTENTION : ne jamais committer de vraie valeur ici — générer avec :
#   openssl rand -hex 32
TURN_SECRET=<à générer, jamais committé>
